# ----------------------------------------------------------------------
# IntelliDoc configuration. Copy to `.env` and fill in what you need.
# You only need keys for the provider you actually select below.
# ----------------------------------------------------------------------

# Which providers to use: openai | gemini | local | testing
# (`testing` needs no keys but answers with an echo stub, not a real model.)
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai

# NOTE: changing an embedding model or dimension requires a fresh DATA_DIR —
# the stored FAISS index is only meaningful for the model that produced it.

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional: only for models outside the built-in map, or to shrink
# text-embedding-3-* vectors (e.g. 512).
# OPENAI_EMBEDDING_DIM=

# --- Google Gemini (google-genai SDK) ---
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768

# --- Local (Ollama for the LLM, sentence-transformers for embeddings) ---
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3.1
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- RAG settings ---
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=4
DATA_DIR=./data
