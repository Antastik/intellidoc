# ----------------------------------------------------------------------
# IntelliDoc configuration. Copy to `.env` and fill in what you need.
# You only need keys for the provider you actually select below.
# ----------------------------------------------------------------------

# Which providers to use: openai | gemini | local
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Google Gemini ---
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# --- Local (Ollama for the LLM, sentence-transformers for embeddings) ---
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3.1
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- RAG settings ---
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=4
DATA_DIR=./data
